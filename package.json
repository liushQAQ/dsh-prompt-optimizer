{
  "name": "dsh-prompt-optimizer",
  "version": "1.6.0",
  "description": "DeepSeek Harness 提示词智能优化与思考强度动态自适应插件",
  "license": "MIT",
  "author": "liushQAQ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liushQAQ/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/liushQAQ/dsh-prompt-optimizer#readme",
  "bugs": {
    "url": "https://github.com/liushQAQ/dsh-prompt-optimizer/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "prompt-optimizer",
    "reasoning-effort",
    "thinking"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0",
    "react": "^18.2.0 || ^19.0.0",
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0"
  }
}
